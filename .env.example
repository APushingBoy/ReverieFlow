# ASR API 配置
ASR_API_KEY=your_asr_api_key
ASR_API_URL=wss://api.example.com/asr/stream
ASR_MODEL=whisper-1

# 文本润色 API 配置
REWRITE_API_KEY=your_rewrite_api_key
REWRITE_API_URL=https://api.example.com/chat/completions
REWRITE_MODEL=gpt-4o-mini

# 音频配置
SAMPLE_RATE=16000
CHANNELS=1
CHUNK_SIZE=1024

# UI 配置
APP_NAME=ReverieFlow
WINDOW_WIDTH=800
WINDOW_HEIGHT=600
